    r6.y = r6.y + r6.w;
    r11.xyzw = dlightSpotShadowmapPixelAdjust.xyxy * float4(0.0787070021,-0.715322971,0.72447902,-0.58079797) + r7.xyxy;
    r6.w = shadowmapSamplerSpot.SampleCmpLevelZero(SpotShadowSamplerState_s, r11.xy, r7.z).x;
    r6.y = r6.y + r6.w;
    r6.w = shadowmapSamplerSpot.SampleCmpLevelZero(SpotShadowSamplerState_s, r11.zw, r7.z).x;
    r6.y = r6.y + r6.w;
    r11.xyzw = dlightSpotShadowmapPixelAdjust.xyxy * float4(0.487471998,-0.0630820021,-0.084077999,0.898311973) + r7.xyxy;
    r6.w = shadowmapSamplerSpot.SampleCmpLevelZero(SpotShadowSamplerState_s, r11.xy, r7.z).x;
    r6.y = r6.y + r6.w;
    r6.w = shadowmapSamplerSpot.SampleCmpLevelZero(SpotShadowSamplerState_s, r11.zw, r7.z).x;
    r6.y = r6.y + r6.w;
    r11.xyzw = dlightSpotShadowmapPixelAdjust.xyxy * float4(-0.494551986,-0.711050987,-0.946592987,0.225134999) + r7.xyxy;
    r6.w = shadowmapSamplerSpot.SampleCmpLevelZero(SpotShadowSamplerState_s, r11.xy, r7.z).x;
    r6.y = r6.y + r6.w;
    r6.w = shadowmapSamplerSpot.SampleCmpLevelZero(SpotShadowSamplerState_s, r11.zw, r7.z).x;
    r6.y = r6.y + r6.w;
    r7.xy = dlightSpotShadowmapPixelAdjust.xy * float2(0.154514998,0.465377003) + r7.xy;
    r6.w = shadowmapSamplerSpot.SampleCmpLevelZero(SpotShadowSamplerState_s, r7.xy, r7.z).x;
    r6.y = r6.y + r6.w;
    r6.y = r6.y * 0.0833333358 + -1;
    r6.y = dlightSpotFactors.w * r6.y + 1;
    r1.xyz = r9.xyz * r3.www + -r1.xyz;
    r3.w = dot(r1.xyz, r1.xyz);
    r3.w = rsqrt(max(r3.w, 1.0e-8f));
    r1.xyz = r3.www * r1.xyz;
    r3.w = saturate(dot(r0.xyz, r1.xyz));
    r1.x = saturate(dot(r1.xyz, r10.xyz));
    r1.y = log2(r3.w);
    r0.w = r1.y * r0.w;
    r0.w = exp2(r0.w);
    r0.w = r6.x * r0.w;
    r1.y = r1.x * r1.x;
    r1.y = r1.y * r4.w + r6.z;
    r1.y = r5.z / r1.y;
