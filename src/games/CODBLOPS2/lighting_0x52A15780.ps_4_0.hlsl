  r0.xyz = v1.www * r0.xyz + v0.xyz;
  r0.xyz = hdrControl0.xxx * r0.xyz;

  // Prevent negative or non-finite lighting values from entering the final
  // gamma-2 square root. HDR values above 1.0 remain untouched.
  r0.xyz = float3(
    (r0.x == r0.x) ? r0.x : 0.0f,
    (r0.y == r0.y) ? r0.y : 0.0f,
    (r0.z == r0.z) ? r0.z : 0.0f
  );
  r0.xyz = min(max(r0.xyz, 0.0f.xxx), 65504.0f.xxx);
  o0.xyz = sqrt(r0.xyz);
  o0.w = 1;
  return;
}