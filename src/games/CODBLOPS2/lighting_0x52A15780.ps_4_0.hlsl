    r1.x = exp2(r1.x);
    r4.xyz = r4.xyz * r1.xxx + r5.xyw;
    r0.w = r1.y * r0.w;
    r1.xyz = r0.www * r4.xyz;
    r1.xyz = r1.xyz * r2.zzz;
    r4.x = dot(r8.xyzw, dlightSpotMatrix0.xyzw);
    r4.y = dot(r8.xyzw, dlightSpotMatrix1.xyzw);
    r0.w = dot(r8.xyzw, dlightSpotMatrix3.xyzw);
    r1.w = sqrt(max(r1.w, 0.0f));
    r1.w = saturate(r1.w * dlightPosition.w + 1);
    r1.w = r1.w * r1.w;
    r2.z = dot(r10.xyz, dlightSpotDir.xyz);
    r2.z = saturate(r2.z * dlightSpotFactors.x + dlightSpotFactors.y);
