// RenoDX: decode to linear, film grain (non-vanilla), then the RenoDX intermediate
float3 FinishPixel(float3 color, int2 pos) {
  color = renodx::color::srgb::DecodeSafe(color);
  if (RENODX_TONE_MAP_TYPE != 0.f) {
    uint2 size; g_xOutputUAV.GetDimensions(size.x, size.y);
